# Server Port
PORT=3000

# Security & CORS (comma separated domain list or *)
ALLOWED_ORIGINS=*

# Download Limits & Concurrency
MAX_PLAYLIST_SIZE=200
MAX_CONCURRENT_SESSIONS=5
CONCURRENT_DOWNLOADS_PER_SESSION=2

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_MAX_REQUESTS=20

# Session Expiration (in Minutes)
SESSION_TTL_MINUTES=30
ORPHAN_TTL_MINUTES=60

# Optional: Path to Netscape formatted cookies.txt for YouTube Bot-Check Bypass
# YTDLP_COOKIES_PATH=/path/to/cookies.txt
